{
  "name": "hexwar",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hexwar/client",
    "build": "npm run build -w @hexwar/client",
    "test": "vitest run",
    "sim": "tsx tools/sim/src/run-match.ts",
    "map": "tsx tools/sim/src/map-preview.ts",
    "typecheck": "tsc -p packages/shared && tsc -p apps/client --noEmit",
    "build:artifact": "npm run build && node apps/client/scripts/artifact.mjs",
    "balance": "tsx tools/sim/src/balance-table.ts",
    "flow": "tsx tools/sim/src/resource-flow.ts",
    "statvalue": "tsx tools/sim/src/stat-value.ts",
    "pace": "tsx tools/sim/src/pace.ts",
    "war": "tsx tools/sim/src/war.ts",
    "serve": "npm run build && node apps/server/server.mjs",
    "start": "node apps/server/server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
